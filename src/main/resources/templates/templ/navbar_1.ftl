<#--
  TOP NAVIGATION BAR: Contains static company contacts and the localization (i18n) switcher.
-->
<link rel="stylesheet" type="text/css" href="/css_main/navbar_1.css">

<div class="navbar-container1">
    <div class="navbar-left">
        <span style="display: inline-flex; align-items: center;">
            <img src="/images/System_Interface/telephone/telephone.svg" alt="Phone" class="phone-icon">
            <span>XXX XXX XXXXXX</span>
        </span>
    </div>
    <div class="navbar-center">
        <div class="dropdown1">
            <span class="non-selectable larger-click-area-nav1" style="display: inline-flex; align-items: center; margin-right: calc(100vw * 0 / 1366);">
                ПОКУПЦЮ&nbsp;
                <img src="/images/System_Interface/dropdown_symbols/down_red_light.svg" alt="Dropdown" class="dropdown1-icon">
            </span>
            <div class="dropdown1-content">
                <a class="button-like non-selectable">ОПЛАТА І ДОСТАВКА</a>
                <a class="button-like non-selectable">ГАРАНТІЯ ТА ПОВЕРНЕННЯ</a>
                <a class="button-like non-selectable">НОВИНИ</a>
                <a class="button-like non-selectable">ПРОГРАМА ЛОЯЛЬНОСТІ</a>
            </div>
        </div>
        <span class="button-like non-selectable">ПРО НАС</span>
        <span class="button-like non-selectable">КОНТАКТИ</span>
        <span class="button-like non-selectable">САЛОНИ</span>
        <span class="button-like non-selectable">ЛІКАРІ-ОФТАЛЬМОЛОГИ</span>
    </div>

    <div class="navbar-right">
        <div class="dropdown1">
            <span class="non-selectable larger-click-area-nav1" style="display: inline-flex; align-items: center; margin-right: calc(100vw * -16 / 1366);">
                UA&nbsp;
                <img src="/images/System_Interface/dropdown_symbols/down_red_light.svg" alt="Dropdown" class="dropdown1-icon">
            </span>
            <div class="dropdown1-content ua-en">
                <a class="button-like non-selectable">UA</a>
                <a class="button-like non-selectable">EN</a>
            </div>
        </div>
    </div>
</div>

<script src="/js_main/navbar_1.js"></script>
